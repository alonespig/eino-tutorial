# ============ 对话模型（Chat Model）============
# LLM_PROVIDER 可选：deepseek（OpenAI 兼容方式，默认） | deepseek-native | openai | gemini
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 DeepSeek 官方文档/GET /models 返回为准
DEEPSEEK_MODEL=deepseek-flash
# 可选：给“更难的任务”（如 Code Review）用的更强模型，不填则与 DEEPSEEK_MODEL 相同
DEEPSEEK_PRO_MODEL=deepseek-v4-pro


# ============ 向量模型（Embedding，DeepSeek 不提供，需另选）============
# 任何 OpenAI 兼容的 Embedding 服务都可以，例如 OpenAI、阿里云百炼(DashScope 兼容模式)、硅基流动等
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 向量维度，必须与 Redis 索引的 DIM 一致
EMBEDDING_DIM=1024

# ============ 基础设施 ============
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/eino_demo?charset=utf8mb4&parseTime=True&loc=Local